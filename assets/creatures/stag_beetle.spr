  b 6a3a26 ~5 z+1
  a 4a2618 ~4 z+1
  d 2a140c ~2 z+1
  h 2a2220 z+1
  l 1a1412
  m 8a4a2a z+2
  M 5a2e1a z+2
  w d0a080 glow
end

frame crawl0
|.
|.............m
|.....bb.....mm
|..bbwaabbhmm.M
|..daaaaahhMMMM
|..ddaaadbhh
|...ldddl
|....l.l.l

