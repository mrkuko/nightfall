/* scr.rc — icon and version information of nightfall.scr (built by `make` with windres).
 * NF_VNUM = 1,2,3,0 and NF_VSTR = 1.2.3 come from the Makefile's VERSION. */
#include <winver.h>

#define STR2(x) #x
#define STR(x) STR2(x)

1 ICON "docs/images/favicon.ico"

1 VERSIONINFO
FILEVERSION NF_VNUM
PRODUCTVERSION NF_VNUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NIGHTFALL screensaver"
            VALUE "FileVersion", STR(NF_VSTR)
            VALUE "InternalName", "nightfall"
            VALUE "LegalCopyright", "Copyright (c) 2026 mrkuko. MIT License."
            VALUE "OriginalFilename", "nightfall.scr"
            VALUE "ProductName", "NIGHTFALL"
            VALUE "ProductVersion", STR(NF_VSTR)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
